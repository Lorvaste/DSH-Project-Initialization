{
  "name": "dsh-project-initialization",
  "version": "1.0.2",
  "description": "DSH 插件「产品创建对齐」（DSH-Project-Initialization）：双 agent preset 场景——「从零开始」（from-scratch）+「先等等，让我确认一下」（confirm-first），问答六步 + 规格冻结，让 AI 从零做产品每一步对齐你的想法。",
  "type": "module",
  "main": "./core-library/src/index.js",
  "exports": {
    ".": {
      "types": "./core-library/src/index.d.ts",
      "default": "./core-library/src/index.js"
    },
    "./package.json": "./package.json",
    "./presets/*": "./core-library/presets/*"
  },
  "files": [
    "cordis.patch.yml",
    "core-library"
  ],
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-preset",
    "product-creation",
    "spec-driven"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
